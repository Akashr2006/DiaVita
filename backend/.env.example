# Paste your Neon connection string (Neon Console -> Connect -> Node.js)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/diavita?sslmode=verify-full
JWT_SECRET=change-this-to-a-long-random-string
PORT=5000
CORS_ORIGIN=http://localhost:3000
APP_TZ=Asia/Kolkata

# Natural voice for the talking assistant (optional). Get a free key at https://dashboard.sarvam.ai
# Without it, the assistant uses the voices built into the browser.
SARVAM_API_KEY=
# Bulbul v3 voice, e.g. kavitha, priya, ritu, shubh, gokul
SARVAM_SPEAKER=kavitha
